<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\PcMonitor.Core\PcMonitor.Core.csproj" />
    <ProjectReference Include="..\PcMonitor.Collectors\PcMonitor.Collectors.csproj" />
    <ProjectReference Include="..\PcMonitor.Infrastructure\PcMonitor.Infrastructure.csproj" />
    <ProjectReference Include="..\PcMonitor.Application\PcMonitor.Application.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pc-monitor.ico</ApplicationIcon>
    <AssemblyName>PC Monitor</AssemblyName>
    <Product>PC Monitor</Product>
    <Authors>LetsTiger</Authors>
    <Company>LetsTiger</Company>
    <Version>0.0.1-beta</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>0.0.1-beta</InformationalVersion>
    <Copyright>Copyright © LetsTiger 2026</Copyright>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludePresentMon Condition="'$(IncludePresentMon)' == '' and '$(Configuration)' == 'Debug'">true</IncludePresentMon>
    <IncludePresentMon Condition="'$(IncludePresentMon)' == ''">false</IncludePresentMon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\pc-monitor-logo.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludePresentMon)' == 'true'">
    <None Include="..\Tools\PresentMon\PresentMon.exe" Link="Tools\PresentMon\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\Tools\PresentMon\PresentMon.exe')" />
    <None Include="..\Tools\PresentMon\LICENSE.txt" Link="Tools\PresentMon\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\Tools\PresentMon\LICENSE.txt')" />
    <None Include="..\Tools\PresentMon\THIRD_PARTY.txt" Link="Tools\PresentMon\THIRD_PARTY.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\Tools\PresentMon\THIRD_PARTY.txt')" />
  </ItemGroup>
</Project>
