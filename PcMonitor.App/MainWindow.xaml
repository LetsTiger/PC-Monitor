                                                            Binding="{Binding DeviceNameText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Temperatur"
                                                            Width="150"
                                                            Binding="{Binding TemperatureText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Aktivität"
                                                            Width="155"
                                                            Binding="{Binding ActivityText,
                                                                              Mode=OneWay}" />

