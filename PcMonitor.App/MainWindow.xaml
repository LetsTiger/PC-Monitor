                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.AverageInternetLatencyText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Latenz maximal" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.MaximumInternetLatencyText,
