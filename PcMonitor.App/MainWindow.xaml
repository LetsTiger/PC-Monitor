                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Technische Framequelle" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding SelectedRunFrameAnalyses}" SelectedItem="{Binding SelectedManualFrameProcess}" DisplayMemberPath="ApplicationText" />
                                    </StackPanel>
                                </Grid>
