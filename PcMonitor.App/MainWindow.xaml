                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Zeitraum"
                                                            Width="145"
                                                            Binding="{Binding TimeText}" />
                                        <DataGridTextColumn Header="Dauer"
                                                            Width="90"
                                                            Binding="{Binding DurationText}" />
                                        <DataGridTextColumn Header="Stufe"
                                                            Width="90"
                                                            Binding="{Binding SeverityText}" />
                                        <DataGridTextColumn Header="Kategorie"
                                                            Width="110"
                                                            Binding="{Binding CategoryText}" />
                                        <DataGridTextColumn Header="Ursache / Ereignis"
                                                            Width="290"
                                                            Binding="{Binding TitleText}" />
                                        <DataGridTextColumn Header="Quelle"
                                                            Width="180"
                                                            Binding="{Binding SourceText}" />
                                        <DataGridTextColumn Header="Maximum"
                                                            Width="100"
                                                            Binding="{Binding MaximumValueText}" />
                                        <DataGridTextColumn Header="Erklärung"
                                                            Width="*"
                                                            MinWidth="360"
                                                            Binding="{Binding DescriptionText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Einstellungen &amp; Diagnose">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="PC Monitor" />
                        <TextBlock Margin="0,6,0,0" FontSize="17" Text="{Binding ProductVersionText}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding RuntimeVersionText}" />
                        <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PresentMonSessionText}" />

                        <Border Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Darstellung" />
                                <TextBlock Margin="0,6,0,12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Wähle das Farbschema für PC Monitor." />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DarkThemeButton" Width="130" Content="Dunkel"
                                            Click="OnDarkThemeClick" />
                                    <Button x:Name="LightThemeButton" Margin="10,0,0,0" Width="130" Content="Hell"
                                            Click="OnLightThemeClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Diagnosepaket" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Das Paket wird ausschließlich lokal erstellt. Es enthält Logs, anonymisierte Einstellungen, Versionsinformationen, Run-Namen, Prozessnamen, Programmpfade sowie Tabellen- und Sample-Anzahlen, aber keine Messwertreihen und keine Datenbank." />
                                <Button Margin="0,14,0,0" Width="220" Height="38" HorizontalAlignment="Left"
                                        Command="{Binding CreateDiagnosticsPackageCommand}"
                                        Content="Diagnosepaket erstellen" />
                                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="{Binding DiagnosticsStatusText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Datenschutz" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="PC Monitor verwendet keine Telemetrie und führt keine automatischen Uploads durch. Netzwerkzugriffe erfolgen ausschließlich für die konfigurierten Ping-Messungen. Diagnosepakete werden nicht automatisch übertragen." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Credits" />
                                    <TextBlock Margin="0,6,0,0" Text="Entwickelt von LetsTiger" />
                                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Danke an alle Testerinnen und Tester der Beta-Version." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="PC Monitor" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding ProductVersionText}" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="© 2026 LetsTiger" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Panel.ZIndex="100" Background="#66000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunSelectionLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="360" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               Text="Auswertung wird geladen" />
                    <TextBlock Margin="0,7,0,16" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Messwerte und Diagnose werden vorbereitet …" />
                    <ProgressBar Height="6" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
