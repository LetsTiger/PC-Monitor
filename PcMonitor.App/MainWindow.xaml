<Window x:Class="PcMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcMonitor.App.Controls"
        Title="PC Monitor"
        Icon="Assets/pc-monitor-logo.png"
        Width="1500"
        Height="960"
        MinWidth="1120"
        MinHeight="760"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->
        <Border Grid.Row="0" Padding="24,15" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="48" Height="48" Source="Assets/pc-monitor-logo.png" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PC Monitor" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Leistung verstehen. Probleme schneller finden." />
                </StackPanel>

                <Border Grid.Column="2" Padding="4" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EasyModeButton" MinWidth="92" Click="OnEasyModeClick"
                                Style="{StaticResource PrimaryButtonStyle}" Content="Einfach" />
                        <Button x:Name="AdvancedModeButton" MinWidth="92" Margin="4,0,0,0"
                                Click="OnAdvancedModeClick" Content="Erweitert" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MainNavigation" Grid.Row="1" TabStripPlacement="Left"
                    Style="{StaticResource SidebarTabControlStyle}"
                    Background="{DynamicResource WindowBackgroundBrush}">

            <!-- ========================================================= -->
            <!-- AKTUELLER RUN -->
            <!-- ========================================================= -->

            <TabItem x:Name="CurrentRunTab" Header="Messung">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="AdvancedSpacerTwo" Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="AdvancedSpacerThree" Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="AdvancedSpacerFour" Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="AdvancedSpacerOne" Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Run-Name -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Text="Run-Name" />

                            <TextBox Height="36"
                                     Padding="10,6"
                                     FontSize="14"
                                     IsReadOnly="{Binding IsRunning}"
                                     Text="{Binding RunName,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Run-Informationen -->
                        <Border Grid.Row="2"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Status" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding StatusText}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Gestartet" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding StartedAtText}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Beendet" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="{Binding EndedAtText}" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Laufzeit" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding DurationText}" />
                            </Grid>
                        </Border>

                        <!-- Kompakter Startbereich für den einfachen Modus -->
                        <Border x:Name="RunActionsPanel" Grid.Row="4"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Messung steuern" />
                                <TextBlock Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Starte die Messung, nutze deinen PC oder dein Spiel wie gewohnt und stoppe sie anschließend wieder." />
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="48" FontSize="15" FontWeight="SemiBold"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartRunCommand}" Content="Messung starten" />
                                    <Button Grid.Column="2" Height="48" FontSize="15" FontWeight="SemiBold"
                                            Command="{Binding StopRunCommand}" Content="Messung stoppen" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- System und CPU -->
                        <Border x:Name="SystemCpuPanel" Grid.Row="6"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <!-- Überschrift -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />

                                    <!-- Systemwerte -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />

                                    <!-- Abstand -->
                                    <RowDefinition Height="18" />

                                    <!-- CPU-Hardware-Überschrift -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />

                                    <!-- Prozessor -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />

                                    <!-- Package-Temperatur -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />

                                    <!-- Maximale Kerntemperatur -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />

                                    <!-- Durchschnittlicher Takt -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />

                                    <!-- Package-Leistung -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Überschrift -->

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Live-System- und CPU-Werte" />

                                <!-- Systemwerte -->

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="CPU-Auslastung" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="17"
                                           Text="{Binding CpuUsageText}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           VerticalAlignment="Top"
                                           FontWeight="SemiBold"
                                           Text="RAM-Auslastung" />

                                <StackPanel Grid.Row="4"
                                            Grid.Column="1">

                                    <TextBlock FontFamily="Consolas"
                                               FontSize="17"
                                               Text="{Binding MemoryUsageText}" />

                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding MemoryDetailsText}" />
                                </StackPanel>

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Letzte Messung" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding LastMeasurementText}" />

                                <!-- CPU-Hardware -->

                                <TextBlock Grid.Row="8"
                                           Grid.ColumnSpan="2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="CPU-Hardware" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Prozessor" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding CpuNameText}" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Package-Temperatur" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Text="{Binding CpuTemperatureText}" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Maximale Kerntemperatur" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Text="{Binding CpuCoreTemperatureText}" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Durchschnittlicher Takt" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Text="{Binding CpuClockText}" />

                                <TextBlock Grid.Row="18"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="Package-Leistung" />

                                <TextBlock Grid.Row="18"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           Text="{Binding CpuPowerText}" />
                            </Grid>
                        </Border>

                        <!-- GPU -->
                        <Border x:Name="GpuPanel" Grid.Row="8"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Live-GPU-Werte" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Grafikkarte" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Text="{Binding GpuNameText}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Auslastung" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuLoadText}" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Temperatur" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuTemperatureText}" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Hotspot" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuHotspotText}" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Core-Takt" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuCoreClockText}" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Speichertakt" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuMemoryClockText}" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Leistung" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuPowerText}" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="VRAM" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GpuMemoryText}" />
                            </Grid>
                        </Border>

                        <!-- Datenträger -->
                        <Border x:Name="StoragePanel" Grid.Row="10"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="Live-Datenträgerwerte" />

                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Alle erkannten physischen Datenträger" />
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                          MinHeight="110"
                                          MaxHeight="260"
                                          ItemsSource="{Binding LiveDisks}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          SelectionMode="Single">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Datenträger"
                                                            Width="220"
                                                            Binding="{Binding DeviceName,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Temperatur"
                                                            Width="105"
                                                            Binding="{Binding TemperatureText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Aktivität"
                                                            Width="95"
                                                            Binding="{Binding ActivityText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Lesen"
                                                            Width="105"
                                                            Binding="{Binding ReadRateText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Schreiben"
                                                            Width="105"
                                                            Binding="{Binding WriteRateText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Speicher"
                                                            Width="180"
                                                            Binding="{Binding SpaceText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Leben"
                                                            Width="90"
                                                            Binding="{Binding LifeText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Status"
                                                            Width="160"
                                                            Binding="{Binding StatusText,
                                                                              Mode=OneWay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Netzwerk -->
                        <Border x:Name="NetworkPanel" Grid.Row="12"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="18" />

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="24" />

                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Live-Netzwerkwerte" />

                                <!-- Gateway -->

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Standardgateway" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding GatewayAddressText}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Gateway-Latenz" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GatewayLatencyText}" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Gateway-Paketverlust" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GatewayPacketLossText}" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Gateway-Jitter" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding GatewayJitterText}" />

                                <!-- Internet -->

                                <TextBlock Grid.Row="10"
                                           Grid.ColumnSpan="2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Internetverbindung" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Internet-Latenz" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding InternetLatencyText}" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Internet-Paketverlust" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding InternetPacketLossText}" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Internet-Jitter" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding InternetJitterText}" />

                                <TextBlock Grid.Row="18"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Aktuelle Ausfälle" />

                                <TextBlock Grid.Row="18"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Text="{Binding NetworkFailureText}" />

                                <TextBlock Grid.Row="20"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Netzwerkstatus" />

                                <TextBlock Grid.Row="20"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Text="{Binding NetworkStatusText}" />

                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- KOMPAKTES ERGEBNIS -->
            <!-- ========================================================= -->

            <TabItem x:Name="SimpleResultTab" Header="Ergebnis">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Dein Ergebnis" />
                        <TextBlock Margin="0,5,0,18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Die wichtigsten Erkenntnisse der ausgewählten Messung – verständlich zusammengefasst." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="20" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel DataContext="{Binding SelectedRunPerformanceScore}"
                                            VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Performance Score" />
                                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                                               FontSize="46" FontWeight="SemiBold"
                                               Foreground="{Binding RatingBrush}"
                                               Text="{Binding TotalScoreText, TargetNullValue=—}" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{Binding RatingBrush}"
                                               Text="{Binding GradeText, TargetNullValue=—}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="20" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Wahrscheinlichstes Bottleneck" />
                                    <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedRunBottleneck.TitleText, TargetNullValue='Noch kein Ergebnis vorhanden'}" />
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                               Text="{Binding SelectedRunBottleneck.DescriptionText}" />
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="{Binding SelectedRunBottleneck.RecommendationText}" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedRunBottleneck.ConfidenceText, StringFormat='Vertrauen: {0}', TargetNullValue='Vertrauen: —'}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,18,0,0" Padding="20" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel DataContext="{Binding SelectedRunPerformanceScore}">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Kurzbewertung" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding SummaryText, TargetNullValue='Wähle eine abgeschlossene Messung aus, um das Ergebnis anzuzeigen.'}" />
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Text="{Binding BreakdownText}" />
                                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Text="{Binding BreakdownExplanationText}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="20" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Empfohlene nächste Schritte" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SelectedRunRecommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="14"
                                                    Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Text="{Binding CategoryText}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding TitleText}" />
                                                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="Nächster Schritt" />
                                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Text="{Binding DescriptionText}" />
                                                        <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="Erwartetes Ergebnis" />
                                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Text="{Binding ExpectedEffectText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Keine Empfehlungen bedeuten, dass noch keine geeignete Messung ausgewählt oder kein eindeutiges Problem erkannt wurde.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRunRecommendations.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- RUN-HISTORIE -->
            <!-- ========================================================= -->

            <TabItem x:Name="RunHistoryTab" Header="Gespeicherte Runs">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding HistoryStatusText}" />

                    <!-- Run-Liste -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Runs}"
                              SelectedItem="{Binding SelectedRun}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Width="*"
                                                MinWidth="200"
                                                Binding="{Binding Name}" />

                            <DataGridTextColumn Header="Gestartet"
                                                Width="155"
                                                Binding="{Binding StartedAtText}" />

                            <DataGridTextColumn Header="Dauer"
                                                Width="95"
                                                Binding="{Binding DurationText}" />

                            <DataGridTextColumn Header="Status"
                                                Width="120"
                                                Binding="{Binding StatusText}" />

                            <DataGridTextColumn Header="Samples"
                                                Width="90"
                                                Binding="{Binding SampleCountText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Run-Details -->
                    <Border Grid.Row="4"
                            Padding="18"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Ausgewählter Run" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Name" />

                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     MinHeight="32"
                                     Padding="8,4"
                                     Text="{Binding SelectedRunName,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="Gestartet" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding SelectedRun.StartedAtText,
                                                      Mode=OneWay,
                                                      TargetNullValue=—}" />

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="Beendet" />

                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       Text="{Binding SelectedRun.EndedAtText,
                                                      Mode=OneWay,
                                                      TargetNullValue=—}" />

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="Dauer" />

                            <TextBlock Grid.Row="8"
                                       Grid.Column="1"
                                       Text="{Binding SelectedRun.DurationText,
                                                      Mode=OneWay,
                                                      TargetNullValue=—}" />

                            <TextBlock Grid.Row="10"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="Messwerte" />

                            <TextBlock Grid.Row="10"
                                       Grid.Column="1"
                                       Text="{Binding SelectedRun.SampleCountText,
                                                      Mode=OneWay,
                                                      TargetNullValue=—}" />
                        </Grid>
                    </Border>

                    <!-- Aktionen -->
                    <Grid Grid.Row="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">
                            <Button MinWidth="145"
                                    Height="38"
                                    Margin="0,0,12,8"
                                    Padding="16,0"
                                    Command="{Binding RenameRunCommand}"
                                    Content="Run umbenennen" />

                            <Button MinWidth="145"
                                    Height="38"
                                    Margin="0,0,12,8"
                                    Padding="16,0"
                                    Command="{Binding DeleteRunCommand}"
                                    Content="Run löschen" />

                            <Button MinWidth="145"
                                    Height="38"
                                    Margin="0,0,12,8"
                                    Padding="16,0"
                                    Command="{Binding ExportCsvCommand}"
                                    Content="Als CSV exportieren" />

                            <Button MinWidth="145"
                                    Height="38"
                                    Margin="0,0,0,8"
                                    Padding="16,0"
                                    Command="{Binding ExportJsonCommand}"
                                    Content="Als JSON exportieren" />
                        </WrapPanel>

                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding HistoryActionStatusText}" />

                        <TextBlock Grid.Row="4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ExportStatusText}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- RUN-AUSWERTUNG -->
            <!-- ========================================================= -->

            <TabItem x:Name="AdvancedAnalysisTab" Header="Messdaten &amp; Diagnose" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />

                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Überschrift -->
                        <StackPanel Grid.Row="0">
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedRun.Name,
                                                      Mode=OneWay,
                                                      TargetNullValue=Kein Run ausgewählt}" />

                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AnalysisStatusText}" />
                        </StackPanel>
                        
                        <!-- Sample-Übersicht -->
                        <Border Grid.Row="2"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="Gespeicherte Messwerte" />

                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedRunSampleCounts.StatusText,
                                                              Mode=OneWay,
                                                              TargetNullValue=Keine Sample-Informationen verfügbar.}" />
                                </StackPanel>

                                <UniformGrid Grid.Row="2"
                                             Columns="4">

                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Gesamt" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedRunSampleCounts.TotalText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="System" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.SystemText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Netzwerk" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.NetworkText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Hardware" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.HardwareText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Grid.Row="4"
                                             Columns="4">

                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="CPU-Threads" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.CpuCoreText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Datenträger" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.DiskText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Prozesse" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.ProcessText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Netzwerkvorfälle" />

                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="18"
                                                   Text="{Binding SelectedRunSampleCounts.NetworkIncidentsText,
                                                                  Mode=OneWay,
                                                                  TargetNullValue=—}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Systemanalyse -->
                        <Border Grid.Row="4"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Systemanalyse" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="CPU durchschnittlich" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.AverageCpuText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="CPU maximal" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.MaximumCpuText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="RAM durchschnittlich" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.AverageMemoryText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="RAM maximal" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.MaximumMemoryText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Maximal verwendeter RAM" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.MaximumUsedMemoryText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />
                            </Grid>
                        </Border>

                        <!-- CPU-Hardwareanalyse -->
                        <Border Grid.Row="6"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />

                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="CPU-Hardwareanalyse" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Prozessor" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedRunAnalysis.CpuNameText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Temperatur durchschnittlich" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.CpuAverageTemperatureText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Package-Temperatur maximal" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.CpuMaximumTemperatureText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Kerntemperatur maximal" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.CpuMaximumCoreTemperatureText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Takt durchschnittlich" />

                                <TextBlock Grid.Row="10"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.CpuAverageClockText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="12"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Takt Minimum / Maximum" />

                                <StackPanel Grid.Row="12"
                                            Grid.Column="1"
                                            Orientation="Horizontal">

                                    <TextBlock FontFamily="Consolas"
                                               Text="{Binding SelectedRunAnalysis.CpuMinimumClockText,
                                                              Mode=OneWay,
                                                              TargetNullValue=—}" />

                                    <TextBlock Margin="6,0"
                                               Text="/" />

                                    <TextBlock FontFamily="Consolas"
                                               Text="{Binding SelectedRunAnalysis.CpuMaximumClockText,
                                                              Mode=OneWay,
                                                              TargetNullValue=—}" />
                                </StackPanel>

                                <TextBlock Grid.Row="14"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Leistung durchschnittlich" />

                                <TextBlock Grid.Row="14"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.CpuAveragePowerText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="Leistung maximal" />

                                <TextBlock Grid.Row="16"
                                           Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedRunAnalysis.CpuMaximumPowerText,
                                                          Mode=OneWay,
                                                          TargetNullValue=—}" />
                            </Grid>
                        </Border>
                        
                        <!-- CPU-Threadanalyse -->
                        <Border Grid.Row="8"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="CPU-Threadanalyse" />

                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Auslastung der einzelnen logischen Prozessoren" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Padding="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="10">

                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Am stärksten belasteter Thread" />

                                        <TextBlock Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding MostLoadedCpuThreadText,
                                                                  Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="4"
                                        Padding="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="10">

                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Einschätzung" />

                                        <TextBlock Margin="0,4,0,0"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CpuThreadAssessmentText,
                                                                  Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="6"
                                          MinHeight="210"
                                          MaxHeight="420"
                                          ItemsSource="{Binding SelectedRunCpuCoreAnalyses}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thread"
                                                            Width="135"
                                                            Binding="{Binding ThreadText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Ø Last"
                                                            Width="90"
                                                            Binding="{Binding AverageLoadText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Maximum"
                                                            Width="90"
                                                            Binding="{Binding MaximumLoadText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Über 80 %"
                                                            Width="95"
                                                            Binding="{Binding Above80Text,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Über 90 %"
                                                            Width="95"
                                                            Binding="{Binding Above90Text,
                                                                              Mode=OneWay}" />

