                                                            Binding="{Binding PrivateMemoryText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Lesen max."
                                                            Width="110"
                                                            Binding="{Binding ReadRateText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Schreiben max."
                                                            Width="115"
                                                            Binding="{Binding WriteRateText,
                                                                              Mode=OneWay}" />

                                        <DataGridTextColumn Header="Vordergrund"
                                                            Width="105"
                                                            Binding="{Binding ForegroundText,
                                                                              Mode=OneWay}" />

