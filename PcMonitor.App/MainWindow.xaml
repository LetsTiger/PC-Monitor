                                CornerRadius="12">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="Datenträgeranalyse" />

                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Durchschnitt / Maximum während des Runs" />
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                          MinHeight="150"
                                          MaxHeight="320"
